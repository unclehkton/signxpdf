{
  "name": "signxpdf",
  "version": "1.0.0",
  "description": "Browser-based PDF tools with visible signatures and tested privacy boundaries.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "build:qpdf-wasm": "node vendor/qpdf-wasm/build.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:seo-foundation": "node scripts/seo-foundation-check.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "check:seo": "node scripts/generate-sitemap.mjs && node scripts/seo-phase2-check.mjs",
    "test": "node scripts/ensure-build.mjs && vitest run",
    "test:privacy": "node scripts/ensure-playwright.mjs && node tests/e2e/privacy-no-upload.mjs",
    "test:e2e-smoke": "node scripts/ensure-playwright.mjs && node tests/e2e/locale-nav-smoke.mjs",
    "test:perf-lab": "node scripts/ensure-playwright.mjs && node tests/e2e/performance-lab.mjs",
    "test:browser": "npm run test:privacy && npm run test:e2e-smoke && npm run test:perf-lab",
    "test:all": "npm run check && npm test && npm run check:seo && npm run test:browser",
    "ensure:playwright": "node scripts/ensure-playwright.mjs",
    "ensure:build": "node scripts/ensure-build.mjs",
    "measure:perf": "node scripts/measure-phase2-perf.mjs",
    "test:qpdf-wasm": "node vendor/qpdf-wasm/build.mjs --smoke-only",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "cropperjs": "^1.6.2",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "signature_pad": "^5.1.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.6.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.0",
    "playwright": "^1.52.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.55.5",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
